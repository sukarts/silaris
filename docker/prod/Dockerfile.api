# syntax=docker/dockerfile:1
# ── Étape 1 : dépendances Composer ─────────────────────────────────────────
FROM composer:2 AS vendor
WORKDIR /app
COPY apps/api/composer.json apps/api/composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --ignore-platform-reqs

# ── Étape 2 : image d'exécution PHP-FPM ────────────────────────────────────
FROM php:8.3-fpm-alpine AS runtime

# Libs runtime conservées ; seuls les paquets -dev sont retirés après compilation.
# nginx + gettext (envsubst) : le service web sert le HTTP dans le même conteneur.
RUN apk add --no-cache nginx gettext libpq libzip icu-libs libpng freetype libjpeg-turbo \
    && apk add --no-cache --virtual .build-deps postgresql-dev libzip-dev icu-dev libpng-dev freetype-dev libjpeg-turbo-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) pdo_pgsql zip intl gd bcmath opcache pcntl \
    && apk del .build-deps

# Opcache production
RUN { \
    echo 'opcache.enable=1'; \
    echo 'opcache.memory_consumption=256'; \
    echo 'opcache.max_accelerated_files=20000'; \
    echo 'opcache.validate_timestamps=0'; \
    echo 'realpath_cache_size=4096K'; \
  } > /usr/local/etc/php/conf.d/opcache.ini

WORKDIR /var/www
COPY apps/api/ ./
COPY --from=vendor /app/vendor ./vendor
COPY --from=vendor /usr/bin/composer /usr/bin/composer
RUN composer dump-autoload --optimize --no-dev \
    && chown -R www-data:www-data storage bootstrap/cache

COPY docker/prod/api-entrypoint.sh /usr/local/bin/api-entrypoint
COPY docker/prod/api-serve.sh /usr/local/bin/api-serve
COPY docker/prod/nginx-render-main.conf /etc/nginx/nginx-render-main.conf
COPY docker/prod/nginx-render.conf.template /etc/nginx/nginx-render.conf.template
RUN chmod +x /usr/local/bin/api-entrypoint /usr/local/bin/api-serve

# Empreinte du commit, gravée en toute fin pour ne pas invalider les couches
# coûteuses au-dessus. /health la renvoie : c'est ce qui permet de vérifier
# qu'un déploiement a bien été tiré, au lieu de le supposer.
ARG APP_RELEASE=dev
ENV APP_RELEASE=${APP_RELEASE}

USER www-data
EXPOSE 10000
ENTRYPOINT ["api-entrypoint"]
# Service web : nginx (HTTP) + php-fpm. worker/scheduler surchargent ce CMD.
CMD ["api-serve"]

# ── Étape 3 : worker (même image, entrypoint Horizon) ──────────────────────
FROM runtime AS worker
CMD ["php", "artisan", "horizon"]

# ── Étape 4 : scheduler ────────────────────────────────────────────────────
FROM runtime AS scheduler
CMD ["php", "artisan", "schedule:work"]
